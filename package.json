{
  "name": "pulsar-port",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "vue-tsc --noEmit",
    "typecheck:api": "npm run api:types && tsc --project worker/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check && npm run build:web",
    "check:rust": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "check:all": "npm run check && npm run check:rust",
    "hooks:install": "git config core.hooksPath .githooks",
    "api:types": "wrangler types --config worker/wrangler.jsonc --env-interface CloudflareBindings worker/worker-configuration.d.ts",
    "deploy:api:preview": "wrangler deploy --config worker/wrangler.jsonc --env preview",
    "deploy:api:production": "wrangler deploy --config worker/wrangler.jsonc --env production",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "gsap": "^3.15.0",
    "hono": "^4.12.33",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.118.0"
  }
}
