{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pulsar-port-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "minify": true,
  "vars": {
    "APP_ENV": "local",
    "CORS_ORIGIN": "http://localhost:1420",
  },
  "env": {
    "preview": {
      "name": "pulsar-port-api-preview",
      "vars": {
        "APP_ENV": "preview",
        "CORS_ORIGIN": "http://localhost:1420",
      },
    },
    "production": {
      "name": "pulsar-port-api-production",
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGIN": "https://app.pulsar-port.example",
      },
    },
  },
}
